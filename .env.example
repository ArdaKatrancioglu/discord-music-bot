TOKEN=your_discord_bot_token_here
LASTFM_API_KEY=your_lastfm_api_key_here

# Optional. Autoplay works without this by resolving the seed track through MusicBrainz.
# Create a ListenBrainz account and copy the user token from https://listenbrainz.org/settings/
LISTENBRAINZ_TOKEN=

AUTOPLAY_TITLE_SIMILARITY_STRENGTH=0.5
AUTOPLAY_TITLE_SIMILARITY_EXPONENT=4
AUTOPLAY_TITLE_SIMILARITY_REJECT_THRESHOLD=0.95
